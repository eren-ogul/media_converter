<Window x:Class="MediaConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dönüştürücü" Height="600" Width="650"
        WindowStartupLocation="CenterScreen" Background="#F0F3F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık ve Sonucu Göster Butonu -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Medya Dönüştürücü" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <Button Name="BtnSonucuGoster" Content="📁 Sonucu Göster" Width="140" Height="35" HorizontalAlignment="Right" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSonucuGoster_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- İşlem Türü Seçimi (İkiye Bölündü) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Menü: Ses İşlemleri -->
            <GroupBox Grid.Column="0" Header="Ses Formatı Seçimi" Foreground="#34495E" FontWeight="Bold" Padding="10">
                <ComboBox Name="CmbAudio" Height="30" FontSize="13" SelectedIndex="-1" SelectionChanged="CmbAudio_SelectionChanged">
                    <ComboBoxItem Content="MKA (original audio)" Tag="to audio mka.bat"/>
                    <ComboBoxItem Content="AAC" Tag="to audio aac.bat"/>
                    <ComboBoxItem Content="M4A" Tag="to audio m4a.bat"/>
                    <ComboBoxItem Content="MP3" Tag="to audio mp3.bat"/>
                    <ComboBoxItem Content="OGG" Tag="to audio ogg.bat"/>
                    <ComboBoxItem Content="WAW" Tag="to audio waw.bat"/>
                </ComboBox>
            </GroupBox>

            <!-- 2. Menü: Video İşlemleri -->
            <GroupBox Grid.Column="2" Header="Video Çözünürlüğü Seçimi" Foreground="#34495E" FontWeight="Bold" Padding="10">
                <ComboBox Name="CmbVideo" Height="30" FontSize="13" SelectedIndex="-1" SelectionChanged="CmbVideo_SelectionChanged">
                    <ComboBoxItem Content="480p    h264(gpu)" Tag="video downscale (480-h264).bat"/>
                    <ComboBoxItem Content="480p    h265(gpu)" Tag="video downscale (480-h265).bat"/>
                    <ComboBoxItem Content="720p    h264(gpu)" Tag="video downscale (720-h264).bat"/>
                    <ComboBoxItem Content="720p    h265(gpu)" Tag="video downscale (720-h265).bat"/>
                    <ComboBoxItem Content="1080p  h264(gpu)" Tag="video downscale (1080-h264).bat"/>
                    <ComboBoxItem Content="1080p  h265(gpu)" Tag="video downscale (1080-h265).bat"/>
                    <ComboBoxItem Content="1440p  h264(gpu)" Tag="video downscale (1440-h264).bat"/>
                    <ComboBoxItem Content="1440p  h265(gpu)" Tag="video downscale (1440-h265).bat"/>

                    
                    
                    
                    
                </ComboBox>
            </GroupBox>
        </Grid>

        <!-- Dosya Seçimi ve Liste -->
        <GroupBox Grid.Row="2" Header="İşlenecek Dosyalar" Foreground="#34495E" FontWeight="Bold" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox Name="LstDosyalar" Height="90" Margin="0,0,10,0" BorderBrush="#D0D7E5" BorderThickness="1" 
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Margin="0,0,10,0" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" VerticalAlignment="Center"/>

                                <Button Background="#E74C3C" BorderThickness="0" Click="BtnDosyaSil_Click" 
                                        Cursor="Hand" Foreground="White" Grid.Column="1" Height="22" Width="22" Tag="{Binding}"
                                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="11"/>
                                        </Style>
                                    </Button.Resources>
                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z" Fill="White"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Başlangıçta IsEnabled="False" olarak gelir -->
                <Button Name="BtnDosyaSec" IsEnabled="False" Grid.Column="1" Width="125" Height="35" VerticalAlignment="Top" BorderThickness="0" Click="BtnDosyaSec_Click">
                    <!-- Buton İçeriği: Vektör Simge ve Yazı Yan Yana -->
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Vektörel Klasör İkonu -->
                            <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                <Path Data="M10,4H4c-1.1,0-1.99,0.9-1.99,2L2,18c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8c0-1.1-0.9-2-2-2h-8L10,4z" 
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                            <TextBlock Text="Dosyaları Seç" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#828282"/>
                            <Setter Property="Foreground" Value="White"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#606060"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#DCDDE1"/>
                                    <!-- Pasifken hem yazı hem de ikon bu gri rengi alır -->
                                    <Setter Property="Foreground" Value="#A0A0A0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </GroupBox>

        <!-- Log Ekranı -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="10" BorderBrush="#D0D7E5" BorderThickness="1" Margin="0,0,0,15">
            <TextBox Name="TxtLog" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas" Foreground="#34495E" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Başlat Butonu -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="BtnBaslat" Content="Dönüştür" Width="170" Height="40" Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Click="BtnBaslat_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>